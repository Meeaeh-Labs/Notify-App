<!DOCTYPE html>
<html>
<head>
    <title>Edit URLs - Ntfy Task Server</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="dashboard">
        <h1>Edit Ntfy URLs</h1>
        <div class="task-controls">
            <a href="/dashboard"><button>Back to Dashboard</button></a>
            <a href="/logout"><button>Logout</button></a>
        </div>

        <div class="url-container">
            <div class="url-form">
                <h2>Add New URL</h2>
                <form action="/urls/add" method="post">
                    <input type="url" name="url" required placeholder="Enter Ntfy URL">
                    <button type="submit">Save URL</button>
                </form>
            </div>

            <div class="url-list">
                <h2>Saved URLs</h2>
                <table>
                    <tr>
                        <th>URL</th>
                        <th>Manage</th>
                    </tr>
                    <% urls.forEach(function(url) { %>
                        <tr>
                            <td><%= url.url %></td>
                            <td>
                                <form action="/urls/delete/<%= url._id %>" method="post">
                                    <button type="submit">Remove</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
