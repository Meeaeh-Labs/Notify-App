<!DOCTYPE html>
<html>
<head>
    <title>Edit Task - Ntfy Task Server</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1>Edit Task</h1>
    <% if (error) { %>
      <p style="color:red;"><%= error %></p>
    <% } %>
    <form action="/tasks/<%= task._id %>/edit" method="post" enctype="multipart/form-data">
      <label>Title:</label>
      <input type="text" name="title" value="<%= task.title %>" required>
      <br>
      <label>Message:</label>
      <textarea name="message"><%= task.message %></textarea>
      <br>
      <label>Priority:</label>
      <select name="priority" class="dropdown" required>
          <option value="5" <%= task.priority == 5 ? 'selected' : '' %>>5 - Max Priority</option>
          <option value="4" <%= task.priority == 4 ? 'selected' : '' %>>4 - High Priority</option>
          <option value="3" <%= task.priority == 3 ? 'selected' : '' %>>3 - Default Priority</option>
          <option value="2" <%= task.priority == 2 ? 'selected' : '' %>>2 - Low Priority</option>
          <option value="1" <%= task.priority == 1 ? 'selected' : '' %>>1 - Min Priority</option>
      </select>
      <br>
      <label>Scheduled Time:</label>
      <input type="datetime-local" name="scheduledTime" value="<%= task.scheduledTime.toISOString().slice(0,16) %>">
      <br>
      <label>Ntfy URL:</label>
      <select name="ntfyUrlSelect" id="ntfyUrlSelect" class="dropdown" required>
          <% if (typeof userUrls !== 'undefined' && userUrls.length > 0) { %>
              <% userUrls.forEach(function(urlObj){ %>
                  <option value="<%= urlObj.url %>" <%= task.ntfyUrl === urlObj.url ? 'selected' : '' %>><%= urlObj.url %></option>
              <% }); %>
              <option value="other" <%= (typeof userUrls === 'undefined' || userUrls.map(function(u){ return u.url; }).indexOf(task.ntfyUrl) === -1) ? 'selected' : '' %>>Other</option>
          <% } else { %>
              <option value="other" selected>Other</option>
          <% } %>
      </select>
      <div id="otherUrlDiv" style="display: none;">
          <input type="url" name="ntfyUrlOther" id="ntfyUrlOther" class="input" placeholder="Enter custom URL" value="<%= (typeof userUrls === 'undefined' || userUrls.map(function(u){ return u.url; }).indexOf(task.ntfyUrl) === -1) ? task.ntfyUrl : '' %>">
      </div>
      <br>
      <div class="checkbox-container">
          <label for="recurringCheckbox">Make Recurring:</label>
          <input type="checkbox" name="recurring" id="recurringCheckbox" <%= task.recurring ? 'checked' : '' %>>
      </div>
      <div id="recurrenceOptions" style="display: <%= task.recurring ? 'block' : 'none' %>;">
         <label>Recurrence Frequency:</label>
         <select name="recurrence">
            <option value="hourly" <%= task.recurrence === 'hourly' ? 'selected' : '' %>>Hourly</option>
            <option value="daily" <%= task.recurrence === 'daily' ? 'selected' : '' %>>Daily</option>
            <option value="weekly" <%= task.recurrence === 'weekly' ? 'selected' : '' %>>Weekly</option>
            <option value="monthly" <%= task.recurrence === 'monthly' ? 'selected' : '' %>>Monthly</option>
         </select>
      </div>
      <br>
      <label>File (max 2MB, leave blank to keep current file):</label>
      <input type="file" name="file">
      <br>
      <button type="submit">Update Task</button>
    </form>

    <form action="/tasks/<%= task._id %>/delete" method="post" onsubmit="return confirm('Are you sure you want to delete this task?');" style="margin-top:20px;">
      <button type="submit" style="background-color: #ff4f4f;">Delete Task</button>
    </form>

    <form action="/dashboard" method="get">
      <button type="submit">Back to Dashboard</button>
    </form>
    <script>
      document.getElementById('recurringCheckbox').addEventListener('change', function() {
         document.getElementById('recurrenceOptions').style.display = this.checked ? 'block' : 'none';
      });
      document.getElementById('ntfyUrlSelect').addEventListener('change', function() {
          var otherDiv = document.getElementById('otherUrlDiv');
          if (this.value === 'other') {
              otherDiv.style.display = 'block';
              document.getElementById('ntfyUrlOther').required = true;
          } else {
              otherDiv.style.display = 'none';
              document.getElementById('ntfyUrlOther').required = false;
          }
      });
      window.addEventListener('load', function() {
          var select = document.getElementById('ntfyUrlSelect');
          if (select.value === 'other') {
              document.getElementById('otherUrlDiv').style.display = 'block';
              document.getElementById('ntfyUrlOther').required = true;
          }
      });
    </script>
</body>
</html>
