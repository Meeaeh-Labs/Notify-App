<!DOCTYPE html>
<html>
<head>
    <title>Edit URL's - Ntfy Task Server</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1>Edit URL's</h1>
    <div class="button-container">
        <form action="/dashboard" method="get">
            <button type="submit">Back to Dashboard</button>
        </form>
        <form action="/logout" method="get">
            <button type="submit">Logout</button>
        </form>
    </div>
    <div style="display: flex; gap: 40px; width: 90%; margin: 0 auto;">
        <!-- Left column: form to add new URL -->
        <div style="flex: 1;">
            <h2>Add New URL</h2>
            <% if (error) { %>
              <p style="color:red;"><%= error %></p>
            <% } %>
            <form action="/user-urls" method="post">
                <label>ntfy URL:</label>
                <input type="url" name="url" required>
                <br>
                <button type="submit">Save URL</button>
            </form>
        </div>
        <!-- Right column: list of saved URLs -->
        <div style="flex: 1; padding: 10px; border: 1px solid #444; border-radius: 5px;">
            <h2>Your URLs</h2>
            <table>
                <tr>
                    <th>URL</th>
                    <th>Manage</th>
                </tr>
                <% userUrls.forEach(function(urlObj){ %>
                <tr>
                    <td><%= urlObj.url %></td>
                    <td>
                        <form action="/user-urls/<%= urlObj._id %>/delete" method="post" onsubmit="return confirm('Are you sure you want to delete this URL?');">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </table>
        </div>
    </div>
</body>
</html>
